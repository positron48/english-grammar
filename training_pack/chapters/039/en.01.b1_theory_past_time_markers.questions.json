    {
      "type": "mcq_single",
      "prompt": "Какой временной маркер означает «на прошлой неделе»?",
      "choices": [
        {
          "id": "a",
          "text": "tomorrow"
        },
        {
          "id": "b",
          "text": "last week"
        },
        {
          "id": "c",
          "text": "now"
        },
        {
          "id": "d",
          "text": "next month"
        }
      ],
      "correct_answer": "b",
      "explanation": "Last week указывает на прошлую неделю. Tomorrow и next month относятся к будущему, now означает «сейчас».",
