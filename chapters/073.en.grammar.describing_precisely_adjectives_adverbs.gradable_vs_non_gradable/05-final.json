    {
      "id": "b1_what_gradable",
      "type": "theory",
      "title": "Gradable прилагательные имеют степени: *cold → colder → coldest*, *big → bigger*. Они описывают качества, которые могут быть «более/менее».",
      "theory": {
        "concept_id": "gradable_definition",
        "content_md": "Gradable прилагательные имеют степени: *cold → colder → coldest*, *big → bigger*. Они описывают качества, которые могут быть «более/менее».\n\nС такими прилагательными можно использовать **very, quite, fairly, a bit**.",
        "key_points": [],
        "common_mistakes": [],
        "examples": [
          {
            "id": "ex1",
            "text": "The room is very cold.",
            "translation": "Комната очень холодная.",
            "tags": [
              "affirmative"
            ]
          },
          {
            "id": "ex2",
            "text": "This bag is bigger than mine.",
            "translation": "Эта сумка больше моей.",
            "tags": [
              "affirmative"
            ]
          }
        ]
      }
